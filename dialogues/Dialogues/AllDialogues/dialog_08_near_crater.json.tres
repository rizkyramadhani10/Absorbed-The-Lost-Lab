dialogs = {
"1_DIALOG_1": {
"default": "PERINGATAN GAS BERBAHAYA! 
Konsentrasi Sulfur/Belerang tinggi terdeteksi!
Peringatan Tambahan: Bongkahan Sulfur murni memiliki suhu tinggi dan senyawa korosif.
Dilarang keras menyentuh atau mengambilnya secara langsung menggunakan tangan!
Kamu membutuhkan sesuatu untuk menghancurkan sulfurnya tanpa harus menyentuh secara langsung.",
"en": ""
},
"1_DIALOG_2": {
"default": "Di zaman begini tentu tidak ada alat tambang modern... Tapi aku bisa merakit palu darurat!",
"en": ""
},
"1_DIALOG_3": {
"default": "Aku sepertinya membutuhkan 3 bahan utama, yaitu Kayu untuk gagang palu, Batu untuk kepala palu, dan Tali untuk mengikatnya!",
"en": ""
}
}
