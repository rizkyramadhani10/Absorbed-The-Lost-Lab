dialogs = {
"1_DIALOG_1": {
"default": "Tunggu.. Mana jalan raya? Mana toko-toko kota Vosiér? 
Ternyata laboratoriumku benar-benar terlempar ke masa lalu!
Bagaimana caranya aku dapat mencari bahan yang kubutuhkan?!?!",
"en": ""
},
"1_DIALOG_2": {
"default": "Di zaman purba begini tentu belum ada toko kimia..",
"en": ""
},
"1_DIALOG_3": {
"default": "Mendeteksi adanya aktivitas vulkanik di sekitar area!!",
"en": ""
},
"1_DIALOG_4": {
"default": "Hmm.., larutan Asam Sulfat bisa dibuat dari Sulfur (S). 
Dan bahan itu seharusnya bisa didapatkan di kawah vulkanik!
Baiklah Xeno, kamu harus pergi ke kawah itu!",
"en": ""
}
