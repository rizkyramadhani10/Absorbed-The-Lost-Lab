dialogs = {
"1_DIALOG_1": {
"default": "Cairan tumpahan bahan kimia ini mulai terasa panas... 
Aku harus [b]mensterilisasikan diri[/b] terlebih dahulu sebelum terjadi iritasi berat!",
"en": ""
},
"1_DIALOG_2": {
"default": "Tidakk…
Aku tidak boleh melangkah dulu! Sangat berbahaya berjalan dengan tubuh yang terkontaminasi bahan kimia seperti ini",
"en": ""
},
"1_DIALOG_3": {
"default": "Fokus Xeno, [b]sterilisasi diri dulu di Safety Shower[/b]! 
Jangan ceroboh menjelajahi lab dengan tubuh terkontaminasi seperti ini, setelah selesai baru mencari tahu apa yang terjadi pada lab ini",
"en": ""
}
}
