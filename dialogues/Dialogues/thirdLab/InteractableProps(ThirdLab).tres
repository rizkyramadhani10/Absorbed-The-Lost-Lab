dialogs = {
"ANALYTICALBALANCE_DIALOG_2": {
"default": "[b]Analytical Balance (Neraca Analitik)[/b]
\"Timbangan digital dengan tingkat presisi tinggi. Ia bekerja dengan [b]mendeteksi perubahan massa yang sangat kecil hingga satuan sub-miligram[/b] di dalam ruang kaca tertutup.\"",
"en": ""
},
"AQUADESDISPENSER_DIALOG_4": {
"default": "[b]Aquades Dispenser (Dispenser Akuades)[/b]
\"Alat praktis untuk menjaga sterilitas air. Ia bekerja dengan cara [b]mengalirkan air suling murni secara higienis[/b] tanpa perlu membuka botol semprot manual.\"",
"en": ""
},
"BURETTECLAMP_DIALOG_3": {
"default": "[b]Burette Clamp (Klem Buret)[/b]
\"Penyangga logam yang berfungsi untuk [b]memegang buret secara tegak lurus dan stabil[/b] saat dipasang pada tiang statif. Kita membutuhkan ini agar proses [b]titrasi cairan[/b] berjalan dengan lancar.\"",
"en": ""
},
"FUMEHOOD_DIALOG_1": {
"default": "[b]Fumehood (Lemari Asam)[/b]
\"Alat keselamatan wajib di laboratorium. Ia bekerja dengan cara [b]menyedot dan membuang uap gas, asap beracun[/b] keluar dari ruang kerja.\"",
"en": ""
}
}
