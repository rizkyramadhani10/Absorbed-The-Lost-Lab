dialogs = {
"AUTOCLAVE_DIALOG_2": {
"": "",
"default": "[b]Autoclave (Autoklaf)[/b]
\"Sebuah mesin sterilisasi. Autoklaf menggunakan [b]uap panas bertekanan tinggi[/b] untuk [b]membunuh semua bentuk kehidupan mikroba[/b], termasuk spora, pada peralatan gelas dan limbah biohazard.\"",
"en": ""
},
"BURETTECABINET_DIALOG_3": {
"": "",
"default": "[b]Burette Cabinet (Lemari Buret)[/b]
\"Modul penyimpanan ini didesain khusus secara vertikal untuk [b]mengamankan buret kaca yang sangat rapuh[/b]. Buret di dalamnya biasanya digunakan untuk prosedur [b]titrasi presisi tinggi[/b]. Harap ambil dengan hati-hati.\"",
"en": ""
},
"CABINET_DIALOG_4": {
"": "",
"default": "[b]Cabinet (Lemari Penyimpanan)[/b]
\"Lemari penyimpanan standar laboratorium. Biasanya digunakan untuk mengamankan [b]bahan habis pakai, alat pelindung diri, atau reagen non-reaktif[/b]. Pastikan Anda selalu mengunci kembali pintunya setelah mengambil barang.\"",
"en": ""
},
"INCUBATOR_DIALOG_1": {
"": "",
"default": "[b]Incubator[/b]
Alat ini dirancang untuk [b]menjaga dan menginkubasi kultur sel mikrobiologi[/b]. Sistem pemanas internalnya menjaga suhu dan kelembapan agar tetap stabil untuk [b]pertumbuhan organisme[/b].",
"en": ""
},
"MICROSCOPE_DIALOG_6": {
"": "",
"default": "[b]Microscope (Mikroskop)[/b]
\"Perangkat optik esensial dengan lensa objektif perbesaran tinggi.\" 
\"Digunakan untuk [b]mengamati spesimen mikroskopis dan struktur seluler[/b] yang tidak kasat mata.\"",
"en": ""
},
"PHMETER_DIALOG_10": {
"": "",
"default": "[b]pH Meter (Pengukur pH)[/b]
\"Alat ukur analitik elektronik yang digunakan untuk membaca [b]tingkat keasaman/kebasaan (alkalinitas)[/b] dari suatu larutan cair. 
[b]Peringatan:[/b] Selalu pastikan elektroda dibilas menggunakan akuades setelah selesai digunakan agar pembacaan tetap akurat.\"",
"en": ""
},
"REFRIGERATOR_DIALOG_5": {
"": "",
"default": "[b]Laboratory Refrigerator (Kulkas Laboratorium)[/b]
\"Kulkas ini mempertahankan suhu konstan untuk [b]menyimpan enzim, reagen kimia sensitif, dan sampel biologis[/b] agar [b]tidak mengalami degradasi termal[/b].\"",
"en": ""
},
"SONICATOR_DIALOG_7": {
"": "",
"default": "[b]Sonicator (Sonikator)[/b]
\"Mesin ini memancarkan [b]gelombang suara ultrasonik berfrekuensi tinggi[/b] ke dalam cairan. Sangat efektif digunakan untuk [b]memecah membran sel (lisis)[/b], menghomogenkan campuran, atau membersihkan partikel nano.\"",
"en": ""
},
"SPECTROPHOTOMETER_DIALOG_8": {
"": "",
"default": "[b]Spectrophotometer (Spektrofotometer)[/b]
\"Instrumen yang sangat canggih. Ia bekerja dengan cara [b]mengukur intensitas cahaya yang diserap atau ditransmisikan oleh suatu sampel[/b]. Kita membutuhkan ini untuk menghitung [b]konsentrasi zat kimia[/b] atau DNA di dalam sebuah larutan.\"",
"en": ""
},
"THERMOSCIENTIFIC_DIALOG_9": {
"": "",
"default": "[b]Gas Chromatography[/b]
\"Teridentifikasi sebagai perangkat kelas atas bermerek Thermo Scientific. Berdasarkan profil dayanya, ini adalah modul [b]instrumen analitik tingkat lanjut[/b] (kemungkinan besar centrifuge kecepatan tinggi atau mesin pengkopi DNA/PCR). \\",
"en": ""
}
}
