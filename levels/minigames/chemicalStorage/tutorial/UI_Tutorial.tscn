text = "[center][b][font_size=44][color=#1a233a]TUTORIAL MINIGAMES PENATAAN[/color][/font_size][/b]
[font_size=22][color=#7f8c8d]Penataan & Penyimpanan Bahan Kimia[/color][/font_size][/center]"

[node name="KontenTutorial" type="RichTextLabel" parent="TabletFrame" unique_id=630405108]
layout_mode = 0
offset_left = 137.0
offset_top = 291.0
offset_right = 816.0
offset_bottom = 703.0
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_constants/line_separation = 1
theme_override_fonts/normal_font = ExtResource("2_36ip5")
bbcode_enabled = true
text = "[color=#d35400][b]Step 1: IDENTIFIKASI BAHAN[/b][/color]
- Kenali [b][color=#1a233a]4 bahan kimia[/color][/b] yang ada di rak kiri.
- Setiap bahan memiliki [b]kategori[/b] dan [b]sifat[/b] yang berbeda.
- Klik bahan untuk melihat [b]informasi detail[/b] di panel sebelah kanan.

[color=#d35400][b]Step 2: PENYIMPANAN BAHAN[/b][/color]
- [b][color=#2980b9]Seret[/color][/b] bahan kimia ke [b]rak penyimpanan[/b] yang sesuai.
- [color=#27ae60][b]Korosif:[/b][/color] Untuk bahan bersifat [b]korosif[/b] (Asam Sulfat).
- [color=#e67e22][b]Organik:[/b][/color] Untuk bahan bersifat [b]organik[/b] (Etanol).
- [color=#8e44ad][b]Oksidator:[/b][/color] Untuk bahan bersifat [b]oksidator[/b] (Kalium Permanganat).
- [color=#c0392b][b]Beracun:[/b][/color] Untuk bahan bersifat [b]beracun[/b] (Merkuri).

[color=#d35400][b]Step 3: VALIDASI PENYIMPANAN[/b][/color]
- Sistem akan [b][color=#2c3e50]memeriksa[/color][/b] setiap bahan yang kamu tempatkan.
- [color=#27ae60][b]Benar:[/b][/color] Bahan akan menempel di rak.
- [color=#c0392b][b]Salah:[/b][/color] Bahan akan kembali ke rak kiri.
[center][color=#d35400][b]Tempatkan semua bahan dengan benar untuk menyelesaikan minigame![/b][/color][/center]"

